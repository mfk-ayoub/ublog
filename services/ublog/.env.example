# Copy and edit before running `make up`
# ─────────────────────────────────────────────────────────────

# ── Docker images (override once you have real images/builds) ──
GATEWAY_IMAGE=placeholder/gateway:latest
AUTH_IMAGE=placeholder/auth:latest
USERS_IMAGE=placeholder/users:latest
ARTICLES_IMAGE=placeholder/articles:latest

# ── Database ───────────────────────────────────────────────────
POSTGRES_USER=ublog
POSTGRES_PASSWORD=change_me_in_production

# ── JWT keys (RS256 – paste PEM values, escape newlines as \n) ─
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Google OAuth (optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/redirect

# ── Per-service database URLs (optional overrides) ─────────────
AUTH_DATABASE_URL=postgresql://ublog:change_me_in_production@db:5432/ublog_auth
USERS_DATABASE_URL=postgresql://ublog:change_me_in_production@db:5432/ublog_users
ARTICLES_DATABASE_URL=postgresql://ublog:change_me_in_production@db:5432/ublog_articles
